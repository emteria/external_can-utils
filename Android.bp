

PRIVATE_LOCAL_CFLAGS = [
    "-O2",
    "-g",
    "-W",
    "-Wall",
    "-Wno-error=unused-parameter",
    "-DSO_RXQ_OVFL=40",
    "-DPF_CAN=29",
    "-DAF_CAN=PF_CAN",
]

//
// canlib
//

cc_library_static {
    name: "libcan",

    srcs: [
        "lib.c",
        "canframelen.c",
    ],
    local_include_dirs: ["include/"],
    cflags: PRIVATE_LOCAL_CFLAGS,
    vendor: true,

}

